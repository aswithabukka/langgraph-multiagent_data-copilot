# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4

# Anthropic Configuration (alternative to OpenAI)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Application Configuration
DATABASE_URL=sqlite:///./app.db
CHART_DIR=./charts
LOG_LEVEL=INFO

# LLM cache — leave unset to disable. `memory` keeps an in-process cache
# (free, cleared on restart). `sqlite` persists at LLM_CACHE_PATH and
# requires the `langchain-community` package.
# LLM_CACHE=memory
# LLM_CACHE_PATH=./.llm_cache.sqlite

# FastAPI Configuration
API_HOST=0.0.0.0
API_PORT=8000

# CORS — comma-separated list of origins allowed to call the API
CORS_ALLOW_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Streamlit Configuration
STREAMLIT_PORT=8501
