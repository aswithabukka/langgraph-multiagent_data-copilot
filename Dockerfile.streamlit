# Streamlit UI image. Kept minimal — runs as non-root and installs only
# the small set of packages the UI actually needs.
FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Streamlit doesn't need build-essential at runtime; pulling pre-built wheels.
RUN pip install --upgrade pip && \
    pip install \
        "streamlit>=1.28.0,<2" \
        "pandas>=2.1.3,<3" \
        "requests>=2.31.0,<3"

COPY ui /app/ui

RUN useradd --create-home --shell /usr/sbin/nologin appuser && \
    chown -R appuser:appuser /app
USER appuser

EXPOSE 8501

CMD ["streamlit", "run", "ui/streamlit_app.py", "--server.address=0.0.0.0", "--server.port=8501"]
